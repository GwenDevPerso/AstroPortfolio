---
import SectionLabel from './SectionLabel.astro';
import { useTranslations, type Locale } from '../i18n';
import { profile } from '../data/profile';

interface Props {
    lang: Locale;
}

const t = useTranslations(Astro.props.lang);

const links = [
    { label: t.contact.freelance, name: 'Malt', href: profile.links.malt },
    { label: t.contact.network, name: 'LinkedIn', href: profile.links.linkedin },
];
---

<section id="contact" class="container section" aria-labelledby="contact-title">
    <SectionLabel index={5} title={t.contact.label} id="contact-title" />
    <p class="heading" data-reveal>
        {t.contact.headingLine1}<br /><span class="accent">{t.contact.headingLine2}</span>
    </p>
    <p class="text">{t.contact.text}</p>
    <div class="cards">
        {links.map((link) => (
            <a href={link.href} class="card link" target="_blank" rel="noopener noreferrer">
                <span class="label">{link.label}</span>
                <span class="value">{link.name} ↗</span>
            </a>
        ))}
        <div class="card">
            <span class="label">{t.contact.status}</span>
            <span class="value status"><span class="status-dot" aria-hidden="true"></span>{t.contact.available}</span>
        </div>
    </div>
</section>

<style>
    .section {
        padding-block: 100px 60px;
    }

    .heading {
        margin: 28px 0 0;
        font-size: clamp(38px, 7vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.055em;
        font-weight: 600;
    }

    .accent {
        color: var(--accent);
    }

    .text {
        margin: 24px 0 0;
        max-width: 44ch;
        font-size: 16px;
        line-height: 1.55;
        color: var(--fg-soft);
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1px;
        margin-top: 48px;
        background: var(--line);
        border: 1px solid var(--line);
    }

    .card {
        display: block;
        background: var(--surface);
        padding: 24px 20px;
    }

    .link {
        transition:
            background 0.2s,
            color 0.2s;
    }

    .link:hover {
        background: var(--accent);
        color: var(--bg);
    }

    .link:hover .label {
        color: var(--bg);
    }

    .label {
        display: block;
        margin-bottom: 12px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        color: var(--muted);
        text-transform: uppercase;
    }

    .value {
        font-size: 16px;
    }

    .status {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .status .status-dot {
        width: 7px;
        height: 7px;
    }
</style>
