---
import { localeLabels, locales, localizedPath, useTranslations, type Locale } from '../i18n';

interface Props {
    lang: Locale;
    /** Locale-independent path of the current page. */
    path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
---

<nav class="language-picker" aria-label={t.header.languages}>
    <ul>
        {locales.map((l) => (
            <li>
                <a
                    href={localizedPath(l, path)}
                    hreflang={l}
                    lang={l}
                    title={localeLabels[l]}
                    aria-current={l === lang ? 'true' : undefined}
                    data-lang-link
                >
                    {l.toUpperCase()}
                </a>
            </li>
        ))}
    </ul>
</nav>

<script>
    // Keep the current section (#hash) when switching language.
    function syncHash() {
        document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach((link) => {
            const url = new URL(link.href);
            url.hash = window.location.hash;
            link.href = url.toString();
        });
    }

    syncHash();
    window.addEventListener('hashchange', syncHash);
</script>

<style>
    ul {
        display: flex;
        gap: 2px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    a {
        display: block;
        padding: 4px 7px;
        border: 1px solid transparent;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
    }

    a:hover {
        color: var(--accent);
    }

    a[aria-current] {
        color: var(--accent);
        border-color: var(--line-strong);
    }
</style>
