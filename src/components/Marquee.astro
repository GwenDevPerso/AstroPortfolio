---
interface Props {
    text: string;
}

const { text } = Astro.props;
---

<div class="marquee">
    <div class="track">
        <span>{text} ·&nbsp;</span>
        <span aria-hidden="true">{text} ·&nbsp;</span>
    </div>
</div>

<style>
    .marquee {
        position: relative;
        z-index: 2;
        overflow: hidden;
        padding-block: 10px;
        border-block: 1px solid var(--line);
        background: var(--surface);
    }

    .track {
        display: flex;
        width: max-content;
        animation: marquee 30s linear infinite;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--faint);
    }

    .track span {
        padding-right: 20px;
    }
</style>
